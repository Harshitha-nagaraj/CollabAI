NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://collabai:change-me@localhost:5432/collabai
REDIS_URL=redis://localhost:6379
CORS_ORIGINS=http://localhost:3000

# ⚠️  SECURITY: Generate a strong random secret for JWT signing.
# In production, this MUST be at least 32 characters and must not be a placeholder.
# Generate one with: openssl rand -base64 48
JWT_SECRET=<generate-a-strong-random-secret-of-at-least-32-chars>

# Demo authentication bypass (development only).
# Set to "true" ONLY for local development and testing — never in production.
# Defaults to false. Production will reject "true" at startup.
ALLOW_DEMO_AUTH=false

# Enterprise Integrations (Phase 1 & 2 Setup)
# Google Cloud Console (Calendar & Meet)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/integrations/google/callback
FRONTEND_URL=http://localhost:3000
INTEGRATION_ENCRYPTION_KEY=replace-with-a-secure-32-byte-encryption-key-for-tokens

# Microsoft Entra ID / Azure (Teams & Outlook)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Slack API
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Zoom Marketplace
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
