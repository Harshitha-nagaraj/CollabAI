generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  OWNER
  ADMIN
  MEMBER
  GUEST
}

enum WorkspaceVisibility {
  PRIVATE
  PUBLIC
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum MeetingStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  SUMMARIZED
  PROCESSED
}

enum SprintStatus {
  PLANNING
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum ReleaseStatus {
  PLANNING
  SCHEDULED
  RELEASED
  DELAYED
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  COMPLETED
  ON_HOLD
  CANCELLED
}

enum ActivityAction {
  PROJECT_CREATED
  PROJECT_UPDATED
  PROJECT_STATUS_CHANGED
  TASK_CREATED
  TASK_UPDATED
  TASK_STATUS_CHANGED
  TASK_ASSIGNED
  TASK_REASSIGNED
  TASK_UNASSIGNED
  TASK_COMPLETED
  TASK_DUE_DATE_CHANGED
  TASK_DELETED
}

enum ActivityEntityType {
  PROJECT
  TASK
}

// ─── Core Models ─────────────────────────────────────────────────────────────

model User {
  id                      String                 @id @default(uuid()) @db.Uuid
  email                   String                 @unique
  name                    String?
  password                String
  avatarUrl               String?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt

  memberships             Membership[]
  createdProjects         Project[]              @relation("ProjectCreator")
  createdTasks            Task[]                 @relation("TaskCreator")
  assignedTasks           Task[]                 @relation("TaskAssignee")
  createdMeetings         Meeting[]              @relation("MeetingCreator")
  meetingParticipants     MeetingParticipant[]
  documents               Document[]             @relation("DocumentCreator")
  notifications           Notification[]
  createdSprints          Sprint[]               @relation("SprintCreator")
  createdReleases         Release[]              @relation("ReleaseCreator")
  chatMessages            ChatMessage[]
  meetingChatMessages     MeetingChatMessage[]
  simulationScenarios     SimulationScenario[]
  decisions               Decision[]             @relation("DecisionMaker")
  projectRetrospectives   ProjectRetrospective[] @relation("RetroCreator")
  sprintRetrospectives    SprintRetrospective[]  @relation("SprintRetroCreator")
  activities              ProjectActivity[]      @relation("ActivityActor")
  taskComments            TaskComment[]          @relation("TaskCommentAuthor")
  integrationCredentials  IntegrationCredential[]
}

model Workspace {
  id                       String                    @id @default(uuid()) @db.Uuid
  name                     String
  description              String?
  visibility               WorkspaceVisibility       @default(PRIVATE)
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt

  memberships              Membership[]
  projects                 Project[]
  tasks                    Task[]
  meetings                 Meeting[]
  documents                Document[]
  sprints                  Sprint[]
  releases                 Release[]
  aiInsights               AIInsight[]
  notifications            Notification[]
  executiveRecommendations ExecutiveRecommendation[]
  simulationScenarios      SimulationScenario[]
  executiveReports         ExecutiveReport[]
  gitHubRepositories       GitHubRepository[]
  decisions                Decision[]
  goals                    Goal[]
  knowledgeItems           KnowledgeItem[]
  releaseNotes             ReleaseNote[]
  projectRetrospectives   ProjectRetrospective[]
  sprintRetrospectives    SprintRetrospective[]
  learningPatterns        LearningPattern[]
  projectTemplates        ProjectTemplate[]
  activities              ProjectActivity[]
  integrationCredentials  IntegrationCredential[]
}

model Membership {
  id          String    @id @default(uuid()) @db.Uuid
  role        Role      @default(MEMBER)
  userId      String    @db.Uuid
  workspaceId String    @db.Uuid
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
}

model Project {
  id                    String                 @id @default(uuid()) @db.Uuid
  name                  String
  description           String?
  status                ProjectStatus          @default(PLANNING)
  workspaceId           String                 @db.Uuid
  creatorId             String                 @db.Uuid
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  workspace             Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator               User                   @relation("ProjectCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  tasks                 Task[]
  documents             Document[]
  sprints               Sprint[]
  releases              Release[]
  simulationScenarios   SimulationScenario[]
  projectRetrospectives ProjectRetrospective[]
  decisions             Decision[]
  goals                 Goal[]
  gitHubRepositories    GitHubRepository[]
  releaseNotes          ReleaseNote[]
  sprintRetrospectives  SprintRetrospective[]
  activities            ProjectActivity[]
}

model ProjectActivity {
  id          String             @id @default(uuid()) @db.Uuid
  projectId   String             @db.Uuid
  workspaceId String             @db.Uuid
  actorId     String             @db.Uuid
  action      ActivityAction
  entityType  ActivityEntityType
  entityId    String             @db.Uuid
  entityTitle String
  details     Json?
  createdAt   DateTime           @default(now())

  project     Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workspace   Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor       User               @relation("ActivityActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt(sort: Desc)])
  @@index([workspaceId, createdAt(sort: Desc)])
}

model Task {
  id             String           @id @default(uuid()) @db.Uuid
  title          String
  description    String?
  status         TaskStatus       @default(TODO)
  priority       Priority         @default(MEDIUM)
  dueDate        DateTime?
  startDate      DateTime?
  estimatedHours Float?
  storyPoints    Int?
  progress       Int?
  isMilestone    Boolean          @default(false)
  workspaceId    String?          @db.Uuid
  projectId      String           @db.Uuid
  sprintId       String?          @db.Uuid
  creatorId      String           @db.Uuid
  assigneeId     String?          @db.Uuid
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  workspace      Workspace?       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project        Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sprint         Sprint?          @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  creator        User             @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  assignee       User?            @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  dependencies   TaskDependency[] @relation("SuccessorTask")
  dependents     TaskDependency[] @relation("PredecessorTask")
  sprintTasks    SprintTask[]
  pullRequests   PullRequest[]
  comments       TaskComment[]
}

model TaskDependency {
  id            String   @id @default(uuid()) @db.Uuid
  predecessorId String   @db.Uuid
  successorId   String   @db.Uuid
  type          String   @default("FINISH_TO_START")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  predecessor   Task     @relation("PredecessorTask", fields: [predecessorId], references: [id], onDelete: Cascade)
  successor     Task     @relation("SuccessorTask", fields: [successorId], references: [id], onDelete: Cascade)
}

model TaskComment {
  id        String   @id @default(uuid()) @db.Uuid
  taskId    String   @db.Uuid
  authorId  String   @db.Uuid
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author    User     @relation("TaskCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt(sort: Asc)])
}

model Meeting {
  id               String               @id @default(uuid()) @db.Uuid
  title            String
  description      String?
  startTime        DateTime
  endTime          DateTime
  status           MeetingStatus        @default(SCHEDULED)
  type             String?
  summary          String?
  transcript       String?
  actionItems      String?
  decisions        String?
  risks            String?
  deadlines        String?
  pendingQuestions String?
  followUps        String?
  sentiment        String?
  sprintPlan       String?
  workspaceId      String               @db.Uuid
  creatorId        String               @db.Uuid
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  workspace        Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator          User                 @relation("MeetingCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  participants     MeetingParticipant[]
  chatMessages     ChatMessage[]
  documents        Document[]
  meetingChatMessages MeetingChatMessage[]
  meetingDecisions Decision[]
}

model ChatMessage {
  id        String   @id @default(uuid()) @db.Uuid
  meetingId String   @db.Uuid
  userId    String   @db.Uuid
  message   String
  createdAt DateTime @default(now())

  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MeetingChatMessage {
  id        String   @id @default(uuid()) @db.Uuid
  meetingId String   @db.Uuid
  userId    String   @db.Uuid
  message   String
  createdAt DateTime @default(now())

  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MeetingParticipant {
  id        String   @id @default(uuid()) @db.Uuid
  meetingId String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, meetingId])
}

model Document {
  id          String    @id @default(uuid()) @db.Uuid
  title       String
  content     String?
  type        String?
  workspaceId String    @db.Uuid
  projectId   String?   @db.Uuid
  meetingId   String?   @db.Uuid
  creatorId   String    @db.Uuid
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  meeting     Meeting?  @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  creator     User      @relation("DocumentCreator", fields: [creatorId], references: [id], onDelete: Restrict)
}

model AIInsight {
  id          String    @id @default(uuid()) @db.Uuid
  type        String
  workspaceId String    @db.Uuid
  data        String
  generatedAt DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Notification {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  workspaceId String    @db.Uuid
  title       String
  message     String
  type        String    @default("INFO")
  link        String?
  isRead      Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Sprint {
  id                   String                 @id @default(uuid()) @db.Uuid
  name                 String
  goal                 String?
  startDate            DateTime
  endDate              DateTime
  durationDays         Int?
  status               SprintStatus           @default(PLANNING)
  workspaceId          String                 @db.Uuid
  projectId            String?                @db.Uuid
  creatorId            String?                @db.Uuid
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  workspace            Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project              Project?               @relation(fields: [projectId], references: [id], onDelete: SetNull)
  creator              User?                  @relation("SprintCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  tasks                Task[]
  sprintTasks          SprintTask[]
  metrics              SprintMetric[]
  sprintRetrospectives SprintRetrospective[]
}

model SprintTask {
  id        String   @id @default(uuid()) @db.Uuid
  sprintId  String   @db.Uuid
  taskId    String   @db.Uuid
  addedAt   DateTime @default(now())

  sprint    Sprint   @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model SprintMetric {
  id              String   @id @default(uuid()) @db.Uuid
  sprintId        String   @db.Uuid
  date            DateTime @default(now())
  completedPoints Int
  remainingPoints Int

  sprint          Sprint   @relation(fields: [sprintId], references: [id], onDelete: Cascade)
}

model Release {
  id              String             @id @default(uuid()) @db.Uuid
  name            String
  version         String
  targetDate      DateTime
  notes           String?
  status          ReleaseStatus      @default(PLANNING)
  confidenceScore Int?
  workspaceId     String             @db.Uuid
  projectId       String?            @db.Uuid
  creatorId       String?            @db.Uuid
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  workspace       Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project         Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  creator         User?              @relation("ReleaseCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  milestones      ReleaseMilestone[]
  metrics         ReleaseMetric[]
  releaseNotes    ReleaseNote[]
}

model ReleaseMilestone {
  id        String    @id @default(uuid()) @db.Uuid
  releaseId String    @db.Uuid
  title     String
  dueDate   DateTime?
  status    String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  release   Release   @relation(fields: [releaseId], references: [id], onDelete: Cascade)
}

model ReleaseMetric {
  id         String   @id @default(uuid()) @db.Uuid
  releaseId  String   @db.Uuid
  metricData String
  createdAt  DateTime @default(now())

  release    Release  @relation(fields: [releaseId], references: [id], onDelete: Cascade)
}

model ExecutiveRecommendation {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @db.Uuid
  title       String
  description String
  impact      String?
  effort      String?
  status      String   @default("OPEN")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model SimulationScenario {
  id            String   @id @default(uuid()) @db.Uuid
  workspaceId   String   @db.Uuid
  projectId     String?  @db.Uuid
  creatorId     String?  @db.Uuid
  name          String
  description   String?
  parameters    String?
  modifications String?
  result        String?
  results       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project       Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  creator       User?     @relation(fields: [creatorId], references: [id], onDelete: SetNull)
}

model ExecutiveReport {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @db.Uuid
  title       String
  data        String?
  format      String?
  content     String?
  shareToken  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model GitHubRepository {
  id           String        @id @default(uuid()) @db.Uuid
  workspaceId  String        @db.Uuid
  projectId    String?       @db.Uuid
  name         String
  owner        String?
  fullName     String?
  url          String
  isPrivate    Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project      Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  pullRequests PullRequest[]
  commits      CommitRecord[]
}

model PullRequest {
  id            String           @id @default(uuid()) @db.Uuid
  repoId        String           @db.Uuid
  taskId        String?          @db.Uuid
  prNumber      Int              @default(0)
  number        Int?
  title         String
  description   String?
  status        String           @default("OPEN")
  state         String?
  url           String?
  author        String
  aiSummary     String?
  securityNotes String?
  headBranch    String?
  baseBranch    String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  repository    GitHubRepository @relation(fields: [repoId], references: [id], onDelete: Cascade)
  task          Task?            @relation(fields: [taskId], references: [id], onDelete: SetNull)
  commitRecords CommitRecord[]
}

model CommitRecord {
  id            String            @id @default(uuid()) @db.Uuid
  repoId        String            @db.Uuid
  pullRequestId String?           @db.Uuid
  hash          String
  author        String
  authorName    String?
  authorEmail   String?
  url           String?
  message       String
  createdAt     DateTime          @default(now())

  repository    GitHubRepository? @relation(fields: [repoId], references: [id], onDelete: Cascade)
  pullRequest   PullRequest?      @relation(fields: [pullRequestId], references: [id], onDelete: SetNull)
}

model Decision {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  projectId   String?   @db.Uuid
  meetingId   String?   @db.Uuid
  decidedById String?   @db.Uuid
  title       String
  description String?
  category    String?
  type        String?
  context     String?
  decision    String?
  status      String    @default("OPEN")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  meeting     Meeting?  @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  decidedBy   User?     @relation("DecisionMaker", fields: [decidedById], references: [id], onDelete: SetNull)
}

model ReleaseNote {
  id          String     @id @default(uuid()) @db.Uuid
  releaseId   String?    @db.Uuid
  workspaceId String?    @db.Uuid
  projectId   String?    @db.Uuid
  title       String?
  version     String?
  content     String
  createdAt   DateTime   @default(now())

  release     Release?   @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project     Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
}

model Goal {
  id              String    @id @default(uuid()) @db.Uuid
  workspaceId     String    @db.Uuid
  projectId       String?   @db.Uuid
  title           String
  description     String?
  type            String?   @default("QUARTERLY")
  targetMetric    String?
  currentProgress Int       @default(0)
  progress        Int       @default(0)
  status          String    @default("IN_PROGRESS")
  startDate       DateTime?
  targetDate      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project         Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
}

model ProjectRetrospective {
  id                    String    @id @default(uuid()) @db.Uuid
  projectId             String    @unique @db.Uuid
  workspaceId           String?   @db.Uuid
  creatorId             String?   @db.Uuid
  summary               String?
  learnings             String?
  whatWentWell          String?
  whatCausedDelays      String?
  biggestBlockers       String?
  teamAchievements      String?
  lessonsLearned        String?
  futureRecommendations String?
  status                String?   @default("COMPLETED")
  createdAt             DateTime  @default(now())

  project               Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workspace             Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator               User?     @relation("RetroCreator", fields: [creatorId], references: [id], onDelete: SetNull)
}

model SprintRetrospective {
  id                      String    @id @default(uuid()) @db.Uuid
  sprintId                String?   @db.Uuid
  workspaceId             String?   @db.Uuid
  projectId               String?   @db.Uuid
  creatorId               String?   @db.Uuid
  sprintName              String?
  summary                 String?
  learnings               String?
  completedWork           String?
  missedGoals             String?
  unexpectedIssues        String?
  successFactors          String?
  improvementSuggestions String?
  actionItems             String?
  createdAt               DateTime  @default(now())

  sprint                  Sprint?   @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  workspace               Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project                 Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  creator                 User?     @relation("SprintRetroCreator", fields: [creatorId], references: [id], onDelete: SetNull)
}

model KnowledgeItem {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  projectId   String?   @db.Uuid
  title       String
  content     String
  category    String?
  type        String?
  tags        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model LearningPattern {
  id              String   @id @default(uuid()) @db.Uuid
  workspaceId     String   @db.Uuid
  title           String
  description     String
  category        String?
  impactMetric    String?
  confidenceScore Int?
  occurrences     Int?     @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model ProjectTemplate {
  id              String   @id @default(uuid()) @db.Uuid
  workspaceId     String   @db.Uuid
  sourceProjectId String?  @db.Uuid
  name            String
  description     String?
  category        String?
  tags            String?
  tasks           String?
  structure       String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model IntegrationCredential {
  id                    String    @id @default(uuid()) @db.Uuid
  provider              String    // e.g. "google-calendar"
  workspaceId           String    @db.Uuid
  userId                String    @db.Uuid
  accountEmail          String?
  accountName           String?
  encryptedAccessToken String    @db.Text
  encryptedRefreshToken String?   @db.Text
  tokenType             String?   @default("Bearer")
  scope                 String?   @db.Text
  expiresAt             DateTime?
  status                String    @default("CONNECTED") // CONNECTED, EXPIRED, REVOKED
  metadata              Json?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  workspace             Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, workspaceId, userId])
  @@index([workspaceId, provider])
}
